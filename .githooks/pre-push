#!/usr/bin/env bash
set -euo pipefail

[[ -x .githooks/pre-push ]] || exit 0
chain=
if [[ "${1:-}" == --chain ]]; then
  chain=${2:?--chain requires a hook path}
  shift 2
fi
refs=$(mktemp /tmp/punt-kit-pre-push.XXXXXXXX)
trap 'rm -f "$refs"' EXIT
cat > "$refs"

head=
updates=0
while read -r local_ref local_oid _remote_ref _remote_oid; do
  [[ "$local_ref" == '(delete)' || "$local_oid" =~ ^0+$ ]] && continue
  head=${head:-$(git rev-parse HEAD)}
  commit=$(git rev-parse --verify --end-of-options "${local_oid}^{commit}" 2>/dev/null) || commit=
  # A release tag may name an earlier main commit; main's CI already gated it.
  [[ "$local_ref" == refs/tags/* && -n "$commit" && "$commit" != "$head" ]] && continue
  if [[ "$commit" != "$head" ]]; then
    printf 'Cannot test pushed ref %s: check it out and push it separately.\n' "$local_ref" >&2
    exit 1
  fi
  updates=1
done < "$refs"
if ((updates)); then
  if ! git diff --quiet HEAD --; then
    printf '%s\n' 'Uncommitted changes would be tested with the pushed commit: commit or stash them.' >&2
    exit 1
  fi
  make test-push </dev/null
fi
if [[ -n "$chain" ]]; then
  "$chain" "$@" < "$refs"
fi
